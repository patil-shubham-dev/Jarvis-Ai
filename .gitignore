# ══════════════════════════════════════════
#         JARVIS AI — .gitignore
# ══════════════════════════════════════════

# ──── Build outputs ────
/build/
app/build/
**/build/
*.apk
*.aab
*.ap_
*.dex
*.class
*.kotlin_module

# ──── Local config (never commit these) ────
local.properties
keystore.properties
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# ──── API keys & secrets ────
secrets.properties
api_keys.xml
.env
.env.*

# ──── Gradle ────
.gradle/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# ──── IDE: Android Studio / IntelliJ ────
*.iml
*.ipr
*.iws
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
.idea/navEditor.xml
captures/
*.hprof

# ──── IDE: VS Code ────
.vscode/
*.code-workspace

# ──── macOS ────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ──── Windows ────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# ──── Linux ────
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ──── Test outputs ────
/test-results/
/reports/

# ──── Profiling ────
*.trace

# ──── Generated sources ────
app/src/main/java/**/generated/
app/src/debug/
app/src/release/

# ──── Proguard (keep rules, not output) ────
app/proguard/dump.txt
app/proguard/mapping.txt
app/proguard/seeds.txt
app/proguard/usage.txt

# ──── Release signing ────
release/
/release

# ──── Logs ────
*.log
logs/
build_info_log.txt
build_log.txt
build_log_full.txt
build_output.txt
logcat_output.txt

# ──── Python / Backend ────
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env
.venv
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.mypy_cache/

# ──── Frontend / Node ────
node_modules/
.next/
out/
dist/
.npm
.eslintcache
.stylelintcache
*.tsbuildinfo

# ──── OpenCode ────
.opencode/
