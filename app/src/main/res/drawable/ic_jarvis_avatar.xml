<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Outer Glow -->
    <path
        android:pathData="M24,24m-20,0a20,20 0 1,1 40,0a20,20 0 1,1 -40,0"
        android:fillAlpha="0.15">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="24"
                android:centerY="24"
                android:gradientRadius="20"
                android:type="radial">
                <item android:color="#00E5FF" android:offset="0" />
                <item android:color="#00000000" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Ring -->
    <path
        android:pathData="M24,24m-16,0a16,16 0 1,1 32,0a16,16 0 1,1 -32,0"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="8"
                android:startY="8"
                android:endX="40"
                android:endY="40"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0" />
                <item android:color="#2979FF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core -->
    <path
        android:pathData="M24,24m-6,0a6,6 0 1,1 12,0a6,6 0 1,1 -12,0"
        android:fillColor="#00E5FF" />

    <!-- Pulse Accents -->
    <path
        android:pathData="M24,10 L24,14 M38,24 L34,24 M24,38 L24,34 M10,24 L14,24"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeColor="#00E5FF"
        android:strokeAlpha="0.6" />

</vector>
