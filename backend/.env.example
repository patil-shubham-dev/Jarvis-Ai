# ══════════════════════════════════════════════════════════════
# Jarvis AI OS — Environment Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control. It contains secrets.
# ══════════════════════════════════════════════════════════════

# ─── AI Provider API Keys ───────────────────────────────────────
# At least ONE provider key is required for AI features.
# The first provider with a configured key will be auto-selected.

# OpenAI (Recommended) — Get key at https://platform.openai.com/api-keys
# Keys typically start with "sk-" or "sk-proj-"
# OPENAI_API_KEY=sk-...

# Anthropic Claude — Get key at https://console.anthropic.com/
# Keys start with "sk-ant-"
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — Get key at https://aistudio.google.com/apikey
# Keys start with "AIza"
# GOOGLE_API_KEY=AIza...

# ─── Server Configuration ───────────────────────────────────────
# Host address to bind the server to.
# Use "0.0.0.0" to allow external connections (e.g., from Android emulator).
HOST=127.0.0.1

# Port to run the server on.
PORT=8000

# Enable hot reload for development.
# WARNING: Do not enable in production.
DEBUG=false

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── CORS Configuration ─────────────────────────────────────────
# Comma-separated list of allowed origins for browser CORS requests.
# The frontend dev server runs on localhost:3000 by default.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ─── Memory / Vector Store ──────────────────────────────────────
# Directory where ChromaDB persists vector data (optional).
# CHROMA_PERSIST_DIR=./chroma_db
